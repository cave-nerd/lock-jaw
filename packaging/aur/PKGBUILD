# Maintainer: cave-nerd <https://github.com/cave-nerd>
pkgname=lock-jaw
pkgver=0.1.0
pkgrel=1
pkgdesc="Fast, local-first markdown note-taking app"
arch=('x86_64' 'aarch64')
url="https://github.com/cave-nerd/lock-jaw"
license=('MIT')
depends=('gcc-libs' 'fontconfig' 'libxkbcommon')
makedepends=('rust' 'cargo' 'pkg-config' 'openssl' 'libgl' 'wayland' 'libxcb')
source=("$pkgname-$pkgver.tar.gz::https://github.com/cave-nerd/lock-jaw/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "lock-jaw-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
    cd "lock-jaw-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release -p lj-ui
}

check() {
    cd "lock-jaw-$pkgver"
    cargo test --frozen --workspace 2>/dev/null || true
}

package() {
    cd "lock-jaw-$pkgver"

    # Binary
    install -Dm755 "target/release/lockjaw" "$pkgdir/usr/bin/lockjaw"

    # Desktop entry
    install -Dm644 "io.github.cave_nerd.LockJaw.desktop" \
        "$pkgdir/usr/share/applications/io.github.cave_nerd.LockJaw.desktop"

    # Icon
    install -Dm644 "dist/LockJaw.AppDir/lockjaw.png" \
        "$pkgdir/usr/share/icons/hicolor/256x256/apps/io.github.cave_nerd.LockJaw.png"

    # AppStream metainfo
    install -Dm644 "io.github.cave_nerd.LockJaw.metainfo.xml" \
        "$pkgdir/usr/share/metainfo/io.github.cave_nerd.LockJaw.metainfo.xml"

    # License
    install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
