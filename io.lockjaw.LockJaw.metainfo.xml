<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.lockjaw.LockJaw</id>
  <name>Lock Jaw</name>
  <summary>Fast, local-first markdown note-taking</summary>
  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>

  <description>
    <p>
      Lock Jaw is a local-first markdown note-taking app built with Rust and egui.
      Notes are plain .md files stored in a vault directory you choose.
      Features include a live split editor/preview, folder sections,
      drag-and-drop organisation, multiple themes, and optional WebDAV sync.
    </p>
  </description>

  <launchable type="desktop-id">io.lockjaw.LockJaw.desktop</launchable>

  <url type="homepage">https://github.com/lockjaw/lockjaw</url>

  <categories>
    <category>Utility</category>
    <category>TextEditor</category>
  </categories>

  <keywords>
    <keyword>notes</keyword>
    <keyword>markdown</keyword>
    <keyword>editor</keyword>
  </keywords>

  <provides>
    <binary>lockjaw</binary>
  </provides>

  <releases>
    <release version="0.1.0" date="2026-03-01">
      <description>
        <p>Initial release.</p>
      </description>
    </release>
  </releases>

  <content_rating type="oars-1.1"/>
</component>
